server {
    listen 80;
    listen [::]:80;
    server_name ${FLEXIPROJECT_APP_DOMAIN};
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name ${FLEXIPROJECT_APP_DOMAIN};

    ssl_certificate     ${FLEXIPROJECT_SSL_CERT};
    ssl_certificate_key ${FLEXIPROJECT_SSL_KEY};

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options      "nosniff"    always;

    access_log /var/log/nginx/flexiproject.access.log;
    error_log  /var/log/nginx/flexiproject.error.log;

    client_max_body_size 110m;

    proxy_read_timeout 300s;
    proxy_send_timeout 300s;

    location / {
        proxy_pass http://${INTERNAL_FLEXIPROJECT_APP_IP}:8000;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_set_header X-Forwarded-Port  $server_port;
    }
}
