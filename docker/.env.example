# Compose config for this stack: cp docker/.env.example docker/.env
# The Laravel .env is the one at the repository root: cp .env.example .env before the first up.

UID=1000
GID=1000
CONTAINER_USER=dev

FLEXIPROJECT_HOSTNAME=flexiproject
FLEXIPROJECT_APP_DOMAIN=flexiproject.test

# local seeds the demo accounts (password "password") into an empty database.
FLEXIPROJECT_APP_ENV=local
FLEXIPROJECT_APP_DEBUG=true

# The host nginx proxies to INTERNAL_FLEXIPROJECT_APP_IP:8000.
# Check the subnet is free with `ip route` before the first `up`.
INTERNAL_FLEXIPROJECT_SUBNET=10.105.0.0/24
INTERNAL_FLEXIPROJECT_APP_IP=10.105.0.10
INTERNAL_FLEXIPROJECT_DB_IP=10.105.0.11

# Certificate the host nginx serves, rendered by docker/nginx/render.sh.
# Empty locally: `local-tls add <domain>` issues it and nginx picks it by SNI.
FLEXIPROJECT_SSL_CERT=
FLEXIPROJECT_SSL_KEY=

FLEXIPROJECT_MARIADB_ROOT_PASSWORD=
FLEXIPROJECT_MARIADB_DATABASE=flexiproject
FLEXIPROJECT_MARIADB_USER=flexiproject
FLEXIPROJECT_MARIADB_PASSWORD=
